{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Backend: nodemon server.js",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/backend/server.js",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Frontend: Chrome (vite dev)",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend/src"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Backend: seed database",
      "program": "${workspaceFolder}/backend/seed.js",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (backend + frontend)",
      "configurations": ["Backend: nodemon server.js", "Frontend: Chrome (vite dev)"]
    }
  ]
}
